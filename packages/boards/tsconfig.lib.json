{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["../ui/src/components/*"],
      "@/lib/*": ["../ui/src/lib/*"],
      "@/hooks/*": ["../ui/src/hooks/*"],
      "@invana/ui": ["../ui/src"],
      "@invana/ui/*": ["../ui/src/*"],
      "@invana/forms": ["../forms/src"],
      "@invana/editor": ["../editor/src"],
      "@invana/blocks": ["../blocks/src"],
      "@invana/charts": ["../charts/src"],
      "@invana/tables": ["../tables/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
