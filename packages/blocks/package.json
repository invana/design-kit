{
  "name": "@invana/blocks",
  "version": "0.0.31",
  "description": "Invana Design System - Blocks: reusable drawings from a JSON spec, shared by conversations, dashboards and pages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invana/design-kit.git",
    "directory": "packages/blocks"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": null,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "pnpm run build",
    "lint": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.lib.json"
  },
  "peerDependencies": {
    "@invana/charts": "workspace:*",
    "@invana/styling": "workspace:*",
    "@invana/tables": "workspace:*",
    "@invana/ui": "workspace:*",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@invana/charts": "workspace:*",
    "@invana/forms": "workspace:*",
    "@invana/styling": "workspace:*",
    "@invana/tables": "workspace:*",
    "@invana/ui": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
