        "grounding": { "records": 1930, "noun": "receipts" }, "freshness": "06:00" },
      "blocks": [
        { "preset": "grid", "tiles": [
          { "label": "Lead time", "value": "26 d", "delta": "▲ 8 d vs normal", "tone": "bad" },
          { "label": "On time", "value": "61%", "delta": "▼ 22 pts", "tone": "bad" },
          { "label": "Open POs", "value": "142", "delta": "£2.3M" } ] },
        { "preset": "timeseries", "unit": "d",
          "series": [{ "name": "Lead time", "points": [
            ["wk 1", 18.4], ["wk 2", 18.4], ["wk 3", 19.4], ["wk 4", 18.4], ["wk 5", 20.5], ["wk 6", 19.4],
            ["wk 7", 21.5], ["wk 8", 23.6], ["wk 9", 22.6], ["wk 10", 25.7], ["wk 11", 27.8], ["wk 12", 26.0] ] }],
          "band": { "label": "normal range", "lower": 16.3, "upper": 21.5 },
          "marks": [
            { "at": "wk 8", "tone": "warn" }, { "at": "wk 9", "tone": "warn" }, { "at": "wk 10", "tone": "warn" },
            { "at": "wk 11", "tone": "warn" }, { "at": "wk 12", "tone": "warn" } ] },
        { "preset": "timeline", "events": [
          { "when": "wk 8", "text": "Yantian port congestion notice", "tone": "warn" },
          { "when": "wk 10", "text": "Apex moved line 2 to another customer", "tone": "warn" } ] } ] },
    { "id": "t4", "role": "analyst", "text": "What happens to stock-outs if we shift 30% to Brightline?" },
    { "id": "t5", "role": "assistant", "kind": "ask", "stage": "analyse", "state": "answered",
      "ask": { "preset": "form", "question": "Scenario inputs",
        "fields": [
          { "name": "share", "label": "Share moved", "type": "number", "unit": "%", "default": 30 },
          { "name": "leadTime", "label": "Brightline lead time", "type": "number", "unit": "d", "default": 17, "aside": "quoted 14 d" },
          { "name": "unitCost", "label": "Unit cost", "type": "number", "unit": "%", "default": 4.5 },
          { "name": "start", "label": "Starting", "type": "date", "default": "1 Nov 2026" } ],
        "submit": "Compare 0%, 30% and 50%",
        "hint": "Observed lead time is from 38 Brightline POs · prefilled as the safer choice" },
      "value": { "share": 30, "leadTime": 17, "unitCost": 4.5, "start": "1 Nov 2026" } },
    { "id": "t6", "role": "assistant", "kind": "answer", "state": "complete", "flow": "recommend", "pattern": "recommend",
      "label": "scenario", "title": "next quarter",
      "envelope": { "caveats": [{ "label": "unproven", "text": "Brightline has not yet met its quoted 14 days. At its quote, the 30% option falls to 7 stock-out days." }] },
      "blocks": [
        { "preset": "table",
          "columns": [
            { "key": "shift", "label": "Shift" },
            { "key": "stockouts", "label": "Stock-out days", "align": "right" },
            { "key": "cost", "label": "Landed cost", "align": "right" },
            { "key": "largest", "label": "Largest supplier", "align": "right" } ],
          "rows": [
            { "shift": "Stay, 0%", "stockouts": { "value": 21, "tone": "bad" }, "cost": "—", "largest": "100%" },
            { "shift": "30%", "stockouts": 9, "cost": "+£84k", "largest": "70%" },
            { "shift": "50%", "stockouts": 6, "cost": "+£140k", "largest": "50%" } ] },
        { "preset": "narrative", "text": "Moving 30% removes most of the risk: **12 fewer stock-out days for £84k**. The next 20% saves three more days for another £56k." },
        { "preset": "proposal", "title": "recommendation",
          "rows": [
            { "label": "Move", "value": "30% of 43 SKUs to Brightline" },
            { "label": "From", "value": "1 Nov 2026" },
            { "label": "Review", "value": "After 8 weeks" } ],
          "consequence": "Creates draft POs in the ERP for review. Nothing is sent to either supplier.",
          "actions": [
            { "id": "create-drafts", "label": "Create drafts", "variant": "primary" },
            { "id": "try-40", "label": "Try 40%", "variant": "secondary" } ] } ] },
    { "id": "t7", "role": "analyst", "text": "Keep an eye on this for me." },
    { "id": "t8", "role": "assistant", "kind": "ask", "stage": "monitor", "state": "answered",
      "ask": { "preset": "multistep", "steps": [
        { "id": "report", "preset": "single", "question": "When should the report go out?",
          "options": [
            { "value": "mon-0800", "label": "Mondays, 08:00" },
            { "value": "daily-0700", "label": "Daily, 07:00" } ],
          "default": "mon-0800" },
        { "id": "to", "preset": "multi", "question": "Who should receive it?",
          "options": [
            { "value": "me", "label": "You" },
            { "value": "procurement-lead", "label": "Procurement lead" } ],
          "default": ["me", "procurement-lead"] },
        { "id": "alert", "preset": "number", "question": "Alert when Apex on time falls below", "unit": "%", "default": 55 },
        { "id": "until", "preset": "single", "question": "Until when?",
          "options": [
            { "value": "q1-2027", "label": "End of Q1 2027" },
            { "value": "cancelled", "label": "Until I stop it" } ],
          "default": "q1-2027" } ] },
      "value": { "report": "mon-0800", "to": ["me", "procurement-lead"], "alert": 55, "until": "q1-2027" } },
    { "id": "t9", "role": "assistant", "kind": "answer", "state": "complete", "flow": "report", "pattern": "delivery",
      "label": "files",
      "blocks": [
        { "preset": "files", "files": [
          { "name": "supplier-shift-scenario.xlsx", "size": "64 KB", "digest": "3be0a917" },
          { "name": "apex-lead-times-12wk.csv", "size": "18 KB", "digest": "f41c02d8" } ] } ],
      "suggestions": ["Check Brightline's capacity for 50%", "Which SKUs are single-sourced?"] }
  ]
