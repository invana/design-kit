{
  "id": "session-product-data-scientist",
  "title": "Did the onboarding checklist improve retention, or did it just arrive with better users?",
  "analyst": "Data scientist",
  "turns": [
    { "id": "t1", "role": "analyst", "text": "We shipped the onboarding checklist on 2 June. Did it actually improve retention, or did it just arrive with better users?" },
    { "id": "t2", "role": "assistant", "kind": "ask", "stage": "frame", "state": "answered",
      "ask": { "preset": "interpretation", "question": "I read this as",
        "slots": [
          { "id": "measure", "label": "measure", "value": "Active on day 30" },
          { "id": "window", "label": "window", "value": "Signups 2 Jun – 31 Aug" },
          { "id": "population", "label": "population", "value": "Self-serve · 18,412" },
          { "id": "baseline", "label": "baseline", "value": "Signups 3 Mar – 1 Jun" } ] },
      "value": { "measure": "Active on day 30", "window": "Signups 2 Jun – 31 Aug", "population": "Self-serve · 18,412", "baseline": "Signups 3 Mar – 1 Jun" } },
    { "id": "t3", "role": "assistant", "kind": "ask", "stage": "frame", "state": "answered",
      "ask": { "preset": "fork", "question": "Which retention?",
        "readings": [
          { "id": "share", "label": "Share active on day 30", "preview": "76% vs 71%", "hint": "One figure per group" },
          { "id": "time", "label": "Time until churn", "hint": "A curve per group" } ],
        "default": "share" },
      "value": "share" },
    { "id": "t4", "role": "assistant", "kind": "answer", "state": "complete", "flow": "compare", "pattern": "comparison",
      "label": "chart", "title": "active on day 30, by channel",
      "envelope": { "scope": ["Signups 3 Mar – 31 Aug", "Self-serve", "before vs after 2 Jun"],
        "grounding": { "records": 36870, "noun": "accounts" }, "freshness": "29 Sep 06:00",
        "caveats": [{ "label": "mix", "text": "Every channel improved by 2–5 pts, but paid search, which retains best, grew from 22% to 35% of signups. Part of the overall 5-pt rise is mix, not the checklist." }] },
      "blocks": [
        { "preset": "bars", "unit": "%", "caption": "before 2 Jun and after · % of accounts active on day 30",
          "groups": ["paid", "organic", "referral", "partner"],
          "series": [
            { "name": "before 2 Jun", "values": [80, 71, 70, 58] },
            { "name": "after", "values": [83, 75, 72, 63] } ] },
        { "preset": "table",
          "columns": [
            { "key": "channel", "label": "Channel" },
            { "key": "before", "label": "Share before", "align": "right" },
            { "key": "after", "label": "Share after", "align": "right" } ],
          "rows": [
            { "channel": "Paid search", "before": "22%", "after": "35%" },
            { "channel": "Organic", "before": "48%", "after": "41%" },
            { "channel": "Referral", "before": "18%", "after": "15%" },
            { "channel": "Partner", "before": "12%", "after": "9%" } ] } ] },
    { "id": "t5", "role": "analyst", "text": "Control for channel, plan and seats. Does the checklist itself matter?" },
    { "id": "t6", "role": "assistant", "kind": "ask", "stage": "analyse", "state": "answered",
      "ask": { "preset": "modelspec", "question": "Model",
        "outcome": { "field": "active_d30", "type": "bool" },
        "predictors": ["checklist_done"], "controls": ["channel", "plan", "log(seats)"],
        "hint": "Logistic regression, since the outcome is yes or no" },
      "value": { "outcome": "active_d30", "predictors": ["checklist_done"], "controls": ["channel", "plan", "log(seats)"] } },
    { "id": "t7", "role": "assistant", "kind": "ask", "stage": "analyse", "state": "answered",
      "ask": { "preset": "plan", "question": "I'll run these steps",
        "steps": [
          { "id": "load", "label": "Load 36,870 signups", "cost": "4 s", "on": true },
          { "id": "fit", "label": "Fit the model", "cost": "2 s", "on": true },
          { "id": "split", "label": "Split the effect by channel", "cost": "3 s", "on": true },
          { "id": "match", "label": "Match on propensity", "cost": "~2 min", "on": false } ],
        "submit": "Run 3 steps" },
      "value": ["load", "fit", "split"] },
    { "id": "t8", "role": "assistant", "kind": "answer", "state": "complete", "flow": "effects", "pattern": "effects",
      "label": "model", "title": "active on day 30, logistic",
      "envelope": { "grounding": { "records": 36870, "noun": "accounts" },
        "method": "logit(active_d30) ~ checklist + channel + plan + log(seats)",
        "caveats": [{ "label": "observational", "text": "Accounts chose to finish the checklist. Motivated users may both finish it and stay, so read this as an upper bound on the effect." }] },
      "blocks": [
        { "preset": "coef", "caption": "Log-odds · baseline organic, solo plan · 0.21 is about +3.6 pts for the average account",
          "terms": [
            { "term": "Checklist done", "est": 0.21, "se": 0.05, "lo": 0.11, "hi": 0.31, "p": "<0.001", "strong": true },
            { "term": "Paid search", "est": 0.52, "se": 0.05, "lo": 0.42, "hi": 0.62, "p": "<0.001" },
            { "term": "Team plan", "est": 0.64, "se": 0.06, "lo": 0.52, "hi": 0.76, "p": "<0.001" },
            { "term": "log(seats)", "est": 0.18, "se": 0.03, "lo": 0.12, "hi": 0.24, "p": "<0.001" } ] },
        { "preset": "forest", "nullAt": 0, "unit": "pts",
          "rows": [
            { "label": "Paid search", "est": 5.2, "lo": 2.4, "hi": 8.0 },
            { "label": "Organic", "est": 3.4, "lo": 1.2, "hi": 5.6 },
            { "label": "Referral", "est": 2.1, "lo": -1.6, "hi": 5.8 },
            { "label": "Partner", "est": 0.8, "lo": -3.4, "hi": 5.0 },
            { "label": "All", "est": 3.6, "lo": 1.9, "hi": 5.3, "overall": true } ] } ] },
    { "id": "t9", "role": "analyst", "text": "Is the paid-search effect real, or am I reading noise?" },
    { "id": "t10", "role": "assistant", "kind": "ask", "stage": "analyse", "state": "answered",
      "ask": { "preset": "hypothesis", "question": "Paid search, checklist done vs not: which test?",
        "test": "Two-proportion z", "suggested": true, "tails": 2, "alpha": 0.05,
        "hint": "Two-tailed, because the checklist could also have hurt" },
      "value": { "test": "Two-proportion z", "tails": 2, "alpha": 0.05 } },
    { "id": "t11", "role": "assistant", "kind": "answer", "state": "complete", "flow": "significance", "pattern": "significance",
      "label": "test", "title": "paid search, active on day 30",
      "envelope": { "grounding": { "records": 6444, "noun": "accounts" },
        "caveats": [{ "label": "self-selected", "text": "A significant difference between groups that chose themselves. A holdout test on new signups would settle cause." }] },
      "blocks": [
        { "preset": "test", "verdict": "The difference is unlikely to be noise", "evidence": "moderate",
          "groups": "85.1% (n = 3,904) vs 80.3% (n = 2,540)",
          "statistic": "z = 5.04", "p": "p < 0.001", "effect": "+4.8 pts · 95% CI 2.9 – 6.7",
          "assumptions": [
            { "label": "Accounts independent", "ok": true, "detail": "1 row each" },
            { "label": "Expected counts ≥ 10", "ok": true, "detail": "min 500" },
            { "label": "Groups randomised", "ok": false, "detail": "self-selected" } ] },
        { "preset": "box", "unit": "d", "caption": "Active days in the first 30 · median 13 vs 16",
          "groups": [
            { "label": "not done", "min": 2, "q1": 8, "median": 13, "q3": 18, "max": 24, "outliers": [29] },
            { "label": "done", "min": 4, "q1": 11, "median": 16, "q3": 21, "max": 27 } ] } ] },
    { "id": "t12", "role": "analyst", "text": "And do checklist users stay longer, not just past day 30?" },
    { "id": "t13", "role": "assistant", "kind": "answer", "state": "complete", "flow": "timeto", "pattern": "timeto",
      "label": "survival", "title": "time until churn",
      "envelope": { "grounding": { "records": 36870, "noun": "accounts" },
        "caveats": [{ "label": "follow-up", "text": "The latest signups have 29 days of history and the earliest 209. Days beyond 90 rest mostly on accounts from before June." }] },
      "blocks": [
        { "preset": "survival", "unit": "d",
          "curves": [
            { "label": "done", "points": [[0, 100], [10, 93], [20, 86], [40, 79], [60, 74], [90, 69], [120, 66]] },
            { "label": "not", "points": [[0, 100], [10, 90], [20, 81], [40, 71], [60, 65], [90, 60], [120, 57]] } ],
          "atRisk": [{ "at": 0, "n": 36870 }, { "at": 60, "n": 24105 }, { "at": 120, "n": 9812 }] },
        { "preset": "quantiles", "label": "Done", "p10": 12, "p50": 38, "p90": 97, "unit": "d", "max": 120 },
        { "preset": "quantiles", "label": "Not done", "p10": 9, "p50": 31, "p90": 88, "unit": "d", "max": 120,
          "caption": "Days to churn among accounts that churned · P10, P50, P90 on a 0–120 day scale" },
        { "preset": "dumbbell", "a": "not done", "b": "done", "unit": "%",
          "rows": [
            { "label": "Solo", "a": 41, "b": 49 },
            { "label": "Team", "a": 58, "b": 66 },
            { "label": "Business", "a": 67, "b": 72 } ] } ] },
    { "id": "t14", "role": "analyst", "text": "Our churn score was trained before June. Is it still right for these accounts?" },
    { "id": "t15", "role": "assistant", "kind": "ask", "stage": "scope", "state": "answered",
      "ask": { "preset": "range", "question": "Evaluate the churn score across which thresholds?",
        "default": { "min": 0.3, "max": 0.6 },
        "hint": "The alert threshold today is 0.45, inside this range" },
      "value": { "min": 0.3, "max": 0.6 } },
    { "id": "t16", "role": "assistant", "kind": "answer", "state": "complete", "flow": "modelcheck", "pattern": "modelcheck",
      "label": "model check", "title": "churn score v2, signups since 2 Jun",
      "envelope": { "grounding": { "records": 18412, "noun": "accounts" },
        "caveats": [{ "label": "drift", "text": "checklist_done is empty for every account before 2 June, so v2 never learned from it. It misses about half of the churners who finished the checklist." }] },
      "blocks": [
        { "preset": "modeleval", "threshold": 0.45,
          "caption": "At 0.45: catches 66% of churners, 39% of flags are right · gains curve over 0.30–0.60",
          "labels": { "positive": "churned", "negative": "stayed" },
          "confusion": { "tp": 1212, "fp": 1904, "fn": 638, "tn": 14658 },
          "gains": [[0, 0], [11, 44], [24, 67], [39, 81], [61, 93], [100, 100]] },
        { "preset": "profile", "columns": [
          { "name": "logins_wk1", "type": "int", "nulls": "0%", "spread": [30, 100, 70, 40, 20] },
          { "name": "seats", "type": "int", "nulls": "0%", "spread": [100, 45, 20, 10, 5] },
          { "name": "checklist_done", "type": "bool", "nulls": "50%", "spread": [60, 100], "flag": true } ] },
        { "preset": "pivot", "rowLabel": "Churners missed",
          "rows": ["Checklist done", "Not done"], "cols": ["Solo", "Team", "Business"],
          "cells": [[{ "value": "55%", "tone": "bad" }, "44%", "39%"], ["30%", "25%", "21%"]],
          "totals": { "rows": ["47%", "27%"], "cols": ["38%", "31%", "27%"], "all": "34%" } },
        { "preset": "tornado", "base": 10, "unit": "%",
          "inputs": [
            { "label": "Logins wk 1", "low": 17.8, "high": 5.1 },
            { "label": "Plan", "low": 14.2, "high": 6.3 },
            { "label": "Seats", "low": 12.9, "high": 7.4 },
            { "label": "Channel", "low": 11.6, "high": 8.8 },
            { "label": "Checklist", "low": 10, "high": 10, "note": "no swing · not an input" } ] } ] },
    { "id": "t17", "role": "assistant", "kind": "answer", "state": "complete",
      "label": "proposal", "title": "from this thread",
      "blocks": [
        { "preset": "proposal",
          "rows": [
            { "label": "Retrain", "value": "Churn score v3, with checklist_done" },
            { "label": "Data", "value": "Signups since 2 Jun" },
            { "label": "Shadow run", "value": "4 weeks beside v2" } ],
          "consequence": "Starts a training job and a shadow deployment. Alerts keep using v2 until you promote v3.",
          "actions": [
            { "id": "start-retraining", "label": "Start retraining", "variant": "primary" },
            { "id": "edit", "label": "Edit", "variant": "secondary" },
            { "id": "not-now", "label": "Not now", "variant": "ghost" } ] } ],
      "suggestions": ["Design a holdout test of the checklist", "Which checklist steps matter most?"] }
  ]
}
