{
  "id": "data-scientist",
  "name": "Product Data Scientist",
  "role": "Measures what product changes do to activation and retention: experiments, significance tests, models and churn scores.",
  "model": "cloud · claude-sonnet-5",
  "steps": {
    "execute": {
      "key": "execute_sql"
    },
    "project": {
      "key": "shape_for_notebook"
    }
  },
  "record": {
    "understand": {
      "input": [
        {
          "label": "schema",
          "value": "warehouse · analytics.events, accounts, experiments · 41 tables"
        },
        {
          "label": "context",
          "value": "8 prior turns (4 answers, 1 model, 1 test)"
        },
        {
          "label": "model",
          "value": "cloud · claude-sonnet-5 · timeout 120s"
        }
      ],
      "output": [
        {
          "label": "query",
          "value": "SELECT s.step_id,\n       AVG(a.active_d30::int) AS active_d30,\n       COUNT(*) AS accounts\nFROM analytics.checklist_steps s\nJOIN analytics.accounts a USING (account_id)\nWHERE a.signup_at >= '2026-06-02' AND a.channel_group = 'self_serve'\nGROUP BY s.step_id ORDER BY active_d30 DESC",
          "code": true
        },
        {
          "label": "tokens",
          "value": "2,860 in · 142 out"
        }
      ]
    },
    "validate": {
      "input": [
        {
          "label": "query",
          "value": "sha256:3b7e…d04a"
        }
      ],
      "output": [
        {
          "label": "verdict",
          "value": "read-only · no INSERT / UPDATE / DELETE / DDL"
        },
        {
          "label": "tables",
          "value": "checklist_steps, accounts — both in analytics v12"
        }
      ]
    },
    "execute": {
      "input": [
        {
          "label": "query",
          "value": "sha256:3b7e…d04a"
        },
        {
          "label": "connection",
          "value": "snowflake · analytics-prod · XS warehouse"
        },
        {
          "label": "limits",
          "value": "timeout 60s · 50,000 rows"
        }
      ],
      "output": [
        {
          "label": "rows",
          "value": "6 · 1 batch · 1.2M events scanned"
        },
        {
          "label": "emitted",
          "value": "frame.delta ×1"
        }
      ]
    },
    "project": {
      "input": [
        {
          "label": "rows",
          "value": "sha256:a91f…07c3"
        }
      ],
      "output": [
        {
          "label": "notebook",
          "value": "1 dataframe · 6 × 4 · cell 14"
        }
      ]
    }
  },
