{
  "id": "journalist",
  "name": "Investigative Journalist",
  "role": "Follows money and relationships through company registries, officer records, leaked filings and news archives in a knowledge graph.",
  "model": "cloud · claude-sonnet-5",
  "steps": {
    "understand": { "key": "translate_question" },
    "execute": { "key": "execute_graph_query" },
    "project": { "key": "shape_for_story" }
  },
  "record": {
    "understand": {
      "input": [
        { "label": "schema", "value": "corporate-graph v12 · 7 node types · 9 relationship types" },
        { "label": "context", "value": "6 prior turns (4 queries, 2 clarifications) · officer pinned: John Mercer (b. Mar 1961)" },
        { "label": "model", "value": "cloud · claude-sonnet-5 · timeout 120s" }
      ],
      "output": [
        { "label": "query", "value": "MATCH (h:Company {number: \"08412276\"})-[:PARENT_OF*1..2]->(s:Company)\nMATCH (s)-[:REGISTERED_AT]->(a:Address)<-[:REGISTERED_AT]-(c:Company)\nWHERE NOT (h)-[:PARENT_OF*1..2]->(c) AND c <> h\nRETURN a.line1, a.postcode, s.name AS subsidiary,\n       collect(DISTINCT c.name) AS neighbours, count(DISTINCT c) AS n\nORDER BY n DESC", "code": true },
        { "label": "tokens", "value": "2,860 in · 142 out" }
      ]
    },
    "validate": {
      "input": [{ "label": "query", "value": "sha256:3b7e…d104" }],
      "output": [
        { "label": "verdict", "value": "read-only · no CREATE / MERGE / DELETE / SET" },
        { "label": "labels", "value": "Company, Address · PARENT_OF, REGISTERED_AT — all in corporate-graph v12" }
      ]
    },
    "execute": {
      "input": [
        { "label": "query", "value": "sha256:3b7e…d104" },
        { "label": "connection", "value": "neo4j · newsroom-graph · read replica" },
        { "label": "limits", "value": "timeout 60s · page 500 · max 3 hops" }
      ],
      "output": [
        { "label": "rows", "value": "9 · 2 batches" },
        { "label": "sources touched", "value": "Companies House (loaded 30 Sep 06:00) · Meridian Papers index v3" }
      ]
    },
    "project": {
      "input": [{ "label": "rows", "value": "sha256:a91f…07c2" }],
      "output": [
        { "label": "story view", "value": "9 addresses · 41 companies · 58 relationships" },
        { "label": "citations", "value": "each row keeps its registry filing id" }
      ]
    }
  },
