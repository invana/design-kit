{
  "id": "network",
  "name": "Network Analyst",
  "role": "Explores an airports graph with a local model: routes, hubs and who connects where.",
  "model": "local · qwen3-27b",
  "steps": {
    "execute": { "key": "execute_graph_query" },
    "project": { "key": "shape_for_canvas" }
  },
  "record": {
    "understand": {
      "input": [
        { "label": "schema", "value": "model v7 · 5 node types · 6 relationship types" },
        { "label": "context", "value": "3 prior turns (2 queries, 1 clarification)" },
        { "label": "model", "value": "local · qwen3-27b · timeout 120s" }
      ],
      "output": [
        { "label": "query", "value": "MATCH (a:Airline)-[:OPERATES]->(r:Route)-[:FROM]->(:Airport {iata: \"FRA\"})\nMATCH (r)-[:TO]->(:Airport)-[:IN]->(c:Country)\nWITH a, count(DISTINCT c) AS countries\nWHERE countries > 20\nRETURN a.name, countries ORDER BY countries DESC", "code": true },
        { "label": "tokens", "value": "1,240 in · 96 out" }
      ]
    },
    "validate": {
      "input": [{ "label": "query", "value": "sha256:9f2c…a71b" }],
      "output": [
        { "label": "verdict", "value": "read-only · no CREATE / MERGE / DELETE / SET" },
        { "label": "labels", "value": "Airline, Route, Airport, Country — all in model v7" }
      ]
    },
    "execute": {
      "input": [
        { "label": "query", "value": "sha256:9f2c…a71b" },
        { "label": "connection", "value": "neo4j · airports-prod · read replica" },
        { "label": "limits", "value": "timeout 30s · page 500" }
      ],
      "output": [
        { "label": "rows", "value": "14 · 3 batches" },
        { "label": "emitted", "value": "graph.delta ×3" }
      ]
    },
    "project": {
      "input": [{ "label": "rows", "value": "sha256:44e0…c210" }],
      "output": [{ "label": "canvas", "value": "14 nodes · 212 relationships · layout: force" }]
    }
  },
  "session": {
    "id": "airports",
    "title": "Airlines out of Frankfurt",
    "assistant": "Analyst",
    "composer": {
      "placeholder": "Ask anything about your graph…",
