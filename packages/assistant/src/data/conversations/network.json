          "method": "MATCH (a:Airline)-[:OPERATES]->(r:Route)-[:FROM]->(:Airport {iata: \"FRA\"})\nMATCH (r)-[:TO]->(:Airport)-[:IN]->(c:Country)\nWITH a, count(DISTINCT c) AS countries\nWHERE countries > 20\nRETURN a.name, countries ORDER BY countries DESC"
        },
        "outcome": {
