{
  "id": "planner",
  "name": "Supply Chain Planner",
  "role": "Plans supply for 43 SKUs across three DCs: lead times, days of cover, reorders and which supplier carries the volume.",
  "model": "cloud · claude-sonnet-5",
  "record": {
    "understand": {
      "input": [
        {
          "label": "schema",
          "value": "erp warehouse v12 · 38 tables · items, receipts, purchase_orders, stock_on_hand"
        },
        {
          "label": "context",
          "value": "9 prior turns (2 scenarios, 1 schedule, 3 asks)"
        },
        {
          "label": "model",
          "value": "cloud · claude-sonnet-5 · timeout 120s"
        }
      ],
      "output": [
        {
          "label": "query",
          "value": "SELECT s.sku, s.dc, s.on_hand, f.daily_demand,\n       s.on_hand / NULLIF(f.daily_demand, 0) AS days_cover\nFROM stock_on_hand s\nJOIN demand_forecast f USING (sku, dc)\nWHERE s.supplier = 'apex-components'\nORDER BY days_cover ASC",
          "code": true
        },
        {
          "label": "tokens",
          "value": "2,180 in · 142 out"
        }
      ]
    },
    "validate": {
      "input": [
        {
          "label": "query",
          "value": "sha256:c81d…07fa"
        }
      ],
      "output": [
        {
          "label": "verdict",
          "value": "read-only · no INSERT / UPDATE / DELETE / MERGE"
        },
        {
          "label": "tables",
          "value": "stock_on_hand, demand_forecast — both in warehouse v12"
        }
      ]
    },
    "execute": {
      "input": [
        {
          "label": "query",
          "value": "sha256:c81d…07fa"
        },
        {
          "label": "connection",
          "value": "snowflake · erp_wh · read role PLANNER_RO"
        },
        {
          "label": "limits",
          "value": "timeout 60s · page 1,000"
        }
      ],
      "output": [
        {
          "label": "rows",
          "value": "129 · 3 batches"
        },
        {
          "label": "scanned",
          "value": "1.8M rows · 412 MB"
        }
      ]
    },
    "project": {
      "input": [
        {
          "label": "rows",
          "value": "sha256:5ab2…e913"
        },
        {
          "label": "forecast",
          "value": "demand-forecast v4 · ETS · weekly, 13-wk horizon"
        }
      ],
      "output": [
        {
          "label": "shape",
          "value": "43 SKUs × 3 DCs · days of cover · 13-wk projection"
        }
      ]
    }
  },
