{
  "id": "finance-analyst",
  "name": "Finance Analyst",
  "role": "Runs FP&A and the month-end close for a mid-size group: explains variance to budget, books accruals, reforecasts and watches cash.",
  "model": "cloud · claude-sonnet-5",
  "steps": {
    "understand": { "key": "translate_to_sql" },
    "validate": { "key": "check_sql" },
    "execute": { "key": "execute_ledger_query" },
    "project": { "key": "shape_for_pack" }
  },
  "record": {
    "understand": {
      "input": [
        { "label": "schema", "value": "finance warehouse v7 · gl_lines, cost_centres, budgets, accruals, ap_invoices, ar_ledger, bank_balances" },
        { "label": "context", "value": "14 prior turns (5 answers, 4 asks, 1 proposal)" },
        { "label": "model", "value": "cloud · claude-sonnet-5 · timeout 120s" }
      ],
      "output": [
        {
          "label": "query",
          "value": "SELECT date_trunc('week', b.value_date) AS wk,\n       sum(b.closing_gbp) AS cash_gbp\nFROM bank_balances b\nJOIN entities e USING (entity_id)\nWHERE e.group_code = 'HALDEN'\n  AND b.value_date BETWEEN DATE '2026-08-01' AND DATE '2026-09-30'\nGROUP BY 1\nORDER BY 1",
          "code": true
        },
        { "label": "tokens", "value": "3,140 in · 124 out" }
      ]
    },
    "validate": {
      "input": [{ "label": "query", "value": "sha256:7c2e…41ab" }],
      "output": [
        { "label": "verdict", "value": "read-only · no INSERT / UPDATE / DELETE / MERGE" },
        { "label": "tables", "value": "bank_balances, entities — both in finance warehouse v7" },
        { "label": "entitlement", "value": "group consolidated · FP&A view" }
      ]
    },
    "execute": {
      "input": [
        { "label": "query", "value": "sha256:7c2e…41ab" },
        { "label": "connection", "value": "snowflake · fin_wh · FPA_RO role" },
        { "label": "limits", "value": "timeout 60s · 50,000 rows" }
      ],
      "output": [
        { "label": "rows", "value": "427 · 2 batches" },
        { "label": "scanned", "value": "3.4 MB · 0.6 s warehouse time" }
      ]
    },
    "project": {
      "input": [{ "label": "rows", "value": "sha256:e05d…9b12" }],
      "output": [{ "label": "pack", "value": "9 weekly balances · 13-week forecast · 4 tiles" }]
    }
  },
  "session": {
    "id": "session-finance-analyst",
    "title": "Q3 opex over budget, then the reforecast",
    "analyst": "FP&A",
    "assistant": "Analyst",
    "composer": {
      "placeholder": "Ask about the ledger, a budget line or the forecast…",
      "controls": [
        {
          "id": "entity",
          "label": "Entity",
          "options": [
            { "value": "group", "label": "Group, consolidated" },
            { "value": "uk", "label": "Halden UK Ltd" },
            { "value": "ie", "label": "Halden Ireland DAC" },
            { "value": "us", "label": "Halden US Inc" }
          ]
        },
        {
          "id": "model",
          "label": "Model",
          "quiet": true,
          "options": [
            { "value": "claude", "label": "cloud · claude-sonnet-5" },
            { "value": "gpt", "label": "openai · gpt-4o-mini" },
            { "value": "qwen", "label": "local · qwen3-27b" }
          ]
        },
        {
          "id": "timeout",
          "label": "LLM + query timeout",
          "align": "end",
          "quiet": true,
          "default": "120",
          "icon": "M8 14a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zM8 5.5V8.5l1.8 1.2M6.5 1.5h3",
