    "understand": {
      "input": [
        {
          "label": "schema",
          "value": "outcomes warehouse v12 · de-identified · 38 tables"
        },
        {
          "label": "context",
          "value": "11 prior turns (cohort, adjustment, notes, pilot)"
        },
        {
          "label": "definitions",
          "value": "readmission = unplanned · ≤ 30 days · any of 3 hospitals"
        },
        {
          "label": "model",
          "value": "cloud · claude-sonnet-5 · timeout 120s"
        }
      ],
      "output": [
        {
          "label": "query",
          "value": "SELECT e.discharge_dow,\n       count(*) AS episodes,\n       count(r.episode_id) AS readmitted\nFROM episodes e\nLEFT JOIN readmissions r\n  ON r.index_episode_id = e.episode_id\n AND r.unplanned AND r.days_after <= 30\nWHERE e.opcs4 LIKE 'W40%' AND e.elective\n  AND e.discharged BETWEEN '2022-01-01' AND '2026-06-30'\nGROUP BY e.discharge_dow",
          "code": true
        },
        {
          "label": "tokens",
          "value": "3,860 in · 212 out"
        }
      ]
    },
    "validate": {
      "input": [
        {
          "label": "query",
          "value": "sha256:c41d…08e2"
        }
      ],
      "output": [
        {
          "label": "verdict",
          "value": "read-only · no INSERT / UPDATE / DELETE"
        },
        {
          "label": "privacy",
          "value": "no direct identifiers selected · cells under 5 suppressed"
        },
        {
          "label": "tables",
          "value": "episodes, readmissions — both in warehouse v12"
        }
      ]
    },
    "execute": {
      "input": [
        {
          "label": "query",
          "value": "sha256:c41d…08e2"
        },
        {
          "label": "connection",
          "value": "postgres · outcomes-warehouse · read replica"
        },
        {
          "label": "limits",
          "value": "timeout 60s · page 1,000"
        }
