{
  "id": "breeder",
  "name": "Plant Breeder",
  "role": "Breeds drought-tolerant lentil lines from the programme's own varieties: trials, genomic predictions, crosses.",
  "model": "cloud · claude-sonnet-5",
  "record": {
    "understand": {
      "input": [
        {
          "label": "schema",
          "value": "trials v4 · plots, sites, seasons, pedigrees, markers"
        },
        {
          "label": "context",
          "value": "11 prior turns (4 answers, 4 asks)"
        },
        {
          "label": "model",
          "value": "cloud · claude-sonnet-5 · timeout 120s"
        }
      ],
      "output": [
        {
          "label": "query",
          "value": "SELECT v.variety, avg(p.yield_kg_ha) AS yield, avg(p.drought_score) AS drought\nFROM plots p JOIN varieties v USING (variety_id)\nWHERE p.site_class = 'semi-arid' AND p.season BETWEEN 2022 AND 2025\nGROUP BY v.variety ORDER BY drought DESC",
          "code": true
        },
        {
          "label": "tokens",
          "value": "2,310 in · 142 out"
        }
      ]
    },
    "validate": {
      "input": [
        {
          "label": "query",
          "value": "sha256:3b7d…e904"
        }
      ],
      "output": [
        {
          "label": "verdict",
          "value": "read-only · no INSERT / UPDATE / DELETE"
        },
        {
          "label": "tables",
          "value": "plots, varieties, sites — all in trials v4"
        }
      ]
    },
    "execute": {
      "input": [
        {
          "label": "query",
          "value": "sha256:3b7d…e904"
        },
        {
          "label": "connection",
          "value": "postgres · trials-db · read replica"
        },
        {
          "label": "limits",
          "value": "timeout 60s · page 1,000"
        }
      ],
      "output": [
        {
          "label": "rows",
          "value": "1,284 plots · 4 batches"
        },
        {
          "label": "predictions",
          "value": "GBLUP · 42 lines · 3,120 SNPs"
        }
      ]
    },
    "project": {
      "input": [
        {
          "label": "rows",
          "value": "sha256:a91f…07c2"
        }
      ],
      "output": [
        {
          "label": "shaped",
          "value": "42 varieties × 6 traits → answer blocks"
        }
      ]
    }
  },
