          "value": "read-only · no INSERT / UPDATE / DELETE / MERGE"
        },
        {
          "label": "tables",
          "value": "positions, factor_exposures — both in warehouse v12"
        },
        {
          "label": "entitlement",
          "value": "book EQ-EU-LS · trader view"
        }
      ]
    },
    "execute": {
      "input": [
        {
          "label": "query",
          "value": "sha256:3b7d…e019"
        },
        {
          "label": "connection",
          "value": "snowflake · risk_wh · RISK_RO role"
        },
        {
          "label": "limits",
          "value": "timeout 60s · 10,000 rows"
