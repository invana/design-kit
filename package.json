{
  "name": "@invana/blocks",
  "version": "0.0.34",
  "description": "Invana Design System - Blocks: reusable drawings from a JSON spec, shared by conversations, boards and pages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invana/design-kit.git",
    "directory": "packages/blocks"
  },
