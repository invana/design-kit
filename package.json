{
  "name": "@invana/boards",
  "version": "0.0.34",
  "description": "Invana Design System - JSON-driven boards assembled from design-kit panels",
  "homepage": "https://github.com/invana/design-kit#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "design-system",
    "react",
    "board",
    "invana/board"
  ],
  "bugs": {
    "url": "https://github.com/invana/design-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invana/design-kit.git",
    "directory": "packages/boards"
  },
  "license": "MIT",
  "author": "Ravi Raja Merugu",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.lib.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@invana/blocks": "^0.0.34",
    "@invana/charts": "^0.0.34",
    "@invana/editor": "^0.0.34",
    "@invana/forms": "^0.0.34",
    "@invana/styling": "^0.0.34",
    "@invana/tables": "^0.0.34",
    "@invana/ui": "^0.0.34",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "react-hook-form": "^7"
  },
  "dependencies": {
    "lucide-react": "^1.24.0"
  }
}
