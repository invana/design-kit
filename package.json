  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.lib.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@invana/charts": "^0.0.34",
    "@invana/forms": "^0.0.34",
    "@invana/styling": "^0.0.34",
    "@invana/tables": "^0.0.34",
    "@invana/ui": "^0.0.34",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "react-hook-form": "^7"
  }
}
