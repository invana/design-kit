  "sections": [
    {
      "name": "about",
      "title": "About you",
      "aside": "How you appear to the people you work with.",
      "fields": [
        {
          "name": "photo",
          "type": "file",
          "label": "Profile photo",
          "accept": "image/*",
          "maxBytes": 2097152,
          "description": "PNG or JPG, up to 2 MB.",
          "colSpan": 2
        },
        {
          "name": "firstName",
          "type": "text",
          "label": "First name",
          "placeholder": "Ada"
        },
        {
          "name": "lastName",
          "type": "text",
          "label": "Last name",
          "placeholder": "Lovelace"
        },
        {
          "name": "displayName",
          "type": "text",
          "label": "Display name",
          "description": "Shown to others and in the access record.",
          "colSpan": 2
        },
        {
          "name": "gender",
          "type": "select",
          "label": "Gender",
          "options": [
            {
              "label": "Woman",
              "value": "woman"
            },
            {
              "label": "Man",
              "value": "man"
            },
            {
              "label": "Non-binary",
              "value": "non-binary"
            },
            {
              "label": "Prefer not to say",
              "value": "prefer-not"
            }
          ]
        },
        {
          "name": "pronouns",
          "type": "select",
          "label": "Pronouns",
          "options": [
            {
              "label": "she / her",
              "value": "she-her"
            },
            {
              "label": "he / him",
              "value": "he-him"
            },
            {
              "label": "they / them",
              "value": "they-them"
            }
          ]
        },
        {
          "name": "birthday",
          "type": "date",
          "label": "Date of birth",
          "description": "Shown to nobody; used for nothing but your own reference."
        },
        {
          "name": "bio",
          "type": "textarea",
          "label": "About me",
          "placeholder": "A line or two about what you work on.",
          "description": "Shown on your profile. 280 characters at most.",
          "rows": 4,
          "colSpan": 2
        }
      ]
    },
    {
      "name": "account",
      "title": "Sign-in and contact",
      "aside": "How you sign in, and where people can find you.",
      "fields": [
        {
          "name": "username",
          "type": "text",
          "label": "Username",
          "description": "You sign in with it. One change every 30 days."
        },
        {
          "name": "email",
          "type": "text",
          "label": "Email",
          "description": "Invana sends no mail to it."
        },
        {
          "name": "website",
          "type": "text",
          "label": "Website",
          "placeholder": "https://",
          "colSpan": 2
        }
      ]
    },
    {
      "name": "locale",
      "title": "Place and language",
      "aside": "Dates and times follow these.",
      "fields": [
        {
          "name": "location",
          "type": "text",
          "label": "Location",
          "placeholder": "City, country",
          "colSpan": 2
        },
        {
          "name": "timezone",
          "type": "select",
          "label": "Time zone",
          "options": [
            {
              "label": "India (UTC+5:30)",
              "value": "Asia/Kolkata"
            },
            {
              "label": "London (UTC+0)",
              "value": "Europe/London"
            },
            {
              "label": "New York (UTC-5)",
              "value": "America/New_York"
            }
          ]
        },
        {
          "name": "language",
          "type": "select",
          "label": "Language",
          "options": [
            {
              "label": "English",
              "value": "en"
            },
            {
              "label": "Español",
              "value": "es"
            },
            {
              "label": "हिन्दी",
              "value": "hi"
            }
          ]
        },
        {
          "name": "publicProfile",
          "type": "boolean",
          "control": "switch",
          "label": "Show my profile to people in my graphs",
          "colSpan": 2
        }
      ]
    }
  ]
}
