        { "id": "prev", "icon": "prev", "variant": "ghost" },
        { "id": "next", "icon": "next", "variant": "ghost" },
        { "id": "view", "options": ["Dashboard", "plan.yml"], "value": "Dashboard" },
        { "id": "publish", "label": "Publish v5", "icon": "check", "variant": "default" }
      ]
